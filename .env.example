# ═══════════════════════════════════════════════════════════════════════
#  ICONIA-ADMIN 환경 변수
# ═══════════════════════════════════════════════════════════════════════
#
#  ★ localhost ↔ AWS 전환은 아래 "이 한 줄" 만 바꾸면 됩니다.
#
#     DEPLOY_TARGET=local   →  로컬 개발 (localhost:8080 Server · 쿠키 비-Secure · DEV 배지)
#     DEPLOY_TARGET=aws     →  AWS 운영  (실 Server URL · 쿠키 Secure · PROD 배지 · HSTS)
#
#  ICONIA_SERVER_URL / ICONIA_ENV / COOKIE_SECURE 를 따로 만질 필요 없습니다.
#  DEPLOY_TARGET 하나가 전부를 일관되게 결정합니다.
# ───────────────────────────────────────────────────────────────────────

DEPLOY_TARGET=local


# ── 선택적 override (대부분 비워 두면 됩니다) ───────────────────────────
#
# ICONIA_SERVER_URL — Server 베이스 URL.
#   · DEPLOY_TARGET=local 이면 미설정 시 http://localhost:8080 자동 사용.
#   · DEPLOY_TARGET=aws  이면 실 Server URL 을 반드시 여기에 지정해야 합니다
#     (aws 토글은 https 만 허용 — 평문 http 는 부팅 시 차단).
#
# ICONIA_SERVER_URL=https://api.iconia.example.com

# ICONIA_ENV — Sidebar 헤더 환경 배지 (development / staging / production).
#   미설정 시 DEPLOY_TARGET 으로 추론 (local→development, aws→production).
#   staging 처럼 토글 2갈래로 표현 못 하는 경우에만 명시.
# ICONIA_ENV=staging

# 운영자 idle 자동 로그아웃 임계 (분). 기본 30. 5 ≤ N ≤ 480.
# 감사 §5.2 #31 / SOC2 CC6.1. 미설정 시 30 사용.
# ADMIN_IDLE_TIMEOUT_MINUTES=30

# Server Action 허용 origin (운영 배포 시 콤마 구분 다중 호스트).
# 미설정 시 localhost:3000 만 허용 (개발 전용).
# ADMIN_ALLOWED_ORIGIN=admin.iconia.example.com
