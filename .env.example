# 내부 개발/테스트: 로컬에서 띄운 ICONIA-SERVER (Express, 기본 포트 8080).
# 운영: AWS Server 도메인 (예: https://api.iconia.example.com) — .env.local / 배포 환경에서 설정.
ICONIA_SERVER_URL=http://localhost:8080

# 운영자 idle 자동 로그아웃 임계 (분). 기본 30. 5 ≤ N ≤ 480.
# 감사 §5.2 #31 / SOC2 CC6.1. 미설정 시 30 사용.
# ADMIN_IDLE_TIMEOUT_MINUTES=30
