# ═══════════════════════════════════════════════════════════════════════
#  ICONIA-ADMIN 환경 변수
# ═══════════════════════════════════════════════════════════════════════
#
#  ★ Admin 웹은 오직 AWS 실서버(ICONIA-SERVER) 에만 연결합니다.
#    로컬/LAN 백엔드 연결 개념은 제거되었습니다.
#
#  기본 데이터 대상(아래 ALB)은 코드에 내장되어 있어 아무 것도 설정하지
#  않아도 AWS 실서버에 연결됩니다. 도메인/HTTPS 가 준비되면 ICONIA_SERVER_URL
#  env 로만 override 합니다 (env override 가 우선).
#
#    기본 Server URL =
#      http://iconia-prod-alb-1600486872.ap-northeast-2.elb.amazonaws.com
# ───────────────────────────────────────────────────────────────────────


# ── 선택적 override (대부분 비워 두면 됩니다) ───────────────────────────
#
# ICONIA_SERVER_URL — Server 베이스 URL override.
#   · 미설정 시 위 AWS ALB 기본값을 자동 사용합니다.
#   · 운영 도메인/HTTPS 가 준비되면 여기에 실 Server URL 을 지정합니다.
# ICONIA_SERVER_URL=https://api.iconia.example.com

# ICONIA_ENV — Sidebar 헤더 환경 배지 (development / staging / production).
#   미설정 시 production (AWS 실서버 단일 연결).
#   staging 등 별도 표기가 필요한 경우에만 명시.
# ICONIA_ENV=staging

# COOKIE_SECURE_OVERRIDE — 기본 true(Secure 쿠키). 도메인+HTTPS 미보유
#   PoC HTTP 환경에서만 false 로 회피.
# COOKIE_SECURE_OVERRIDE=false

# 운영자 idle 자동 로그아웃 임계 (분). 기본 30. 5 ≤ N ≤ 480.
# 감사 §5.2 #31 / SOC2 CC6.1. 미설정 시 30 사용.
# ADMIN_IDLE_TIMEOUT_MINUTES=30

# Server Action 허용 origin (운영 배포 시 콤마 구분 다중 호스트).
# 미설정 시 localhost:3000 만 허용 (개발 서버 전용 — 데이터 연결과 무관).
# ADMIN_ALLOWED_ORIGIN=admin.iconia.example.com
